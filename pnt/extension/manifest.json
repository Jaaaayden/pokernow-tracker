{
  "manifest_version": 3,
  "name": "PokerNow Tracker",
  "version": "0.1.0",
  "description": "Streams the live PokerNow hand log into the local tracker and shows per-player stats and range charts in a side panel.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.pokernow.com/games/*",
        "https://pokernow.com/games/*",
        "https://www.pokernow.club/games/*",
        "https://pokernow.club/games/*"
      ],
      "js": ["normalize.js", "pager.js", "watch.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "PokerNow Tracker" }
}
